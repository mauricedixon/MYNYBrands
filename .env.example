# Copy to .env.local and fill in. Never commit real keys.

# Public URL of the site (used for share images, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key (Dashboard → Developers → API keys). Use sk_test_... while testing.
# Without it, the checkout button shows "Checkout isn't connected yet".
STRIPE_SECRET_KEY=

# Set to "true" after enabling Stripe Tax in the dashboard
STRIPE_AUTOMATIC_TAX=false
